{
  "name": "ego-browser-hermes",
  "version": "0.2.0",
  "description": "Hermes MCP adapter for the vendored ego-lite agent browser with isolated task spaces and a safe default tool surface.",
  "type": "module",
  "main": "./mcp-server/dist/index.js",
  "exports": {
    ".": "./mcp-server/dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "mcp-server/dist/",
    "runtime/ego-browser/dist/out/index.js",
    "runtime/ego-linux/",
    "runtime/PATCHES.md",
    "skills/ego-browser-hermes/",
    "docs/HERMES.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc -p mcp-server/tsconfig.json --noEmit",
    "test": "vitest run --config mcp-server/vitest.config.ts",
    "build": "tsdown mcp-server/src/index.ts -d mcp-server/dist --format esm --target es2024 --platform node --no-config",
    "smoke": "node scripts/mcp-smoke.mjs",
    "sim": "node scripts/discord-sim.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "mcp:typecheck": "tsc -p mcp-server/tsconfig.json --noEmit",
    "mcp:test": "vitest run --config mcp-server/vitest.config.ts",
    "mcp:build": "tsdown mcp-server/src/index.ts -d mcp-server/dist --format esm --target es2024 --platform node --no-config",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayase0307/ego-browser-hermes.git"
  },
  "homepage": "https://github.com/ayase0307/ego-browser-hermes#readme",
  "bugs": {
    "url": "https://github.com/ayase0307/ego-browser-hermes/issues"
  }
}
